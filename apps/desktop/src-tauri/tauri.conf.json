{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-v2-docs/refs/heads/main/schema.json",
  "productName": "coevo-desktop",
  "version": "1.0.0",
  "identifier": "dev.coevo.desktop",
  "build": {
    "beforeDevCommand": "node scripts/with-artifacts.mjs node scripts/build-sidecar.mjs && node scripts/with-artifacts.mjs vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/with-artifacts.mjs node scripts/build-sidecar.mjs && node scripts/with-artifacts.mjs tsc && node scripts/with-artifacts.mjs vite build",
    "frontendDist": "../../../.artifacts/desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "coevo",
        "width": 1280,
        "height": 860,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["../../../.artifacts/sidecars/coevo-server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
